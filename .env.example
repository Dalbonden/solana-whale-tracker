# ---------------------------------------------------------------------------
# Solana Whale Tracker — environment
# Copy to `.env.local` for local dev; add the same keys in Vercel → Settings →
# Environment Variables for deployment.
#
# SECURITY: this project is read-only analytics. It never needs, reads, or
# stores a private key or seed phrase. Do not add one here.
# ---------------------------------------------------------------------------

# --- Solana RPC (required) -------------------------------------------------
# Helius is recommended: it provides the enhanced-transaction parsing and the
# webhooks that power real-time alerts. https://dashboard.helius.dev
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# --- Market data (required for USD values) ---------------------------------
# https://bds.birdeye.so — free tier works; "Standard" recommended for OHLCV.
BIRDEYE_API_KEY=

# --- Optional enrichment ---------------------------------------------------
# https://pro-api.solscan.io — optional; used for account labels + DeFi
# activity backfill. The app degrades gracefully without it.
SOLSCAN_API_KEY=

# Pump.fun public frontend API. No key required; override only if you proxy it.
PUMPFUN_API_URL=https://frontend-api.pump.fun

# --- Database: Supabase (required) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Job + webhook auth (required) -----------------------------------------
# Random secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -hex 32
CRON_SECRET=
# Random secret registered as the Helius webhook `authHeader` value.
HELIUS_WEBHOOK_SECRET=
# Public URL of this deployment; used when registering the Helius webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Detection thresholds (optional; sensible defaults in src/lib/config.ts) -
WHALE_MIN_PORTFOLIO_USD=250000
WHALE_MIN_TRADE_USD=25000
WHALE_MIN_MEME_EXPOSURE=0.15
WHALE_MIN_TRADES_30D=8
ALERT_LARGE_TRADE_USD=50000
ALERT_CLUSTER_WHALES=3
ALERT_CLUSTER_WINDOW_MINUTES=60
